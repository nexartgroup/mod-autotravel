[worldserver]

########################################
# mod-autotravel configuration
########################################

#    AutoTravel.Enable
#        Modul global ein-/ausschalten.
#        Default: 1
AutoTravel.Enable = 1

#    AutoTravel.ArrivalDistance
#        Zielradius in Yards (2D). Innerhalb dieses Radius gilt das Ziel
#        als erreicht.
#        Minimum 0.5, damit sich auch punktgenaue Ziele einstellen lassen.
#        Default: 8
AutoTravel.ArrivalDistance = 8

########################################
# Wasser und Bodenkontakt
########################################

#    AutoTravel.Swim
#        Wegpunkte im Wasser werden an die Oberflaeche gelegt, statt ueber den
#        Grund zu fuehren. 0 = Reise bricht bei Wasser ab (altes Verhalten).
#        Default: 1
AutoTravel.Swim = 1

#    AutoTravel.SwimSurfaceOffset
#        Wie tief unter dem Wasserspiegel geschwommen wird (Yards).
#        Default: 1.2
AutoTravel.SwimSurfaceOffset = 1.2

#    AutoTravel.MinSwimDepth
#        Ab dieser Wassertiefe wird geschwommen. Darunter ist es eine Furt und
#        der Charakter laeuft normal hindurch.
#        Default: 2
AutoTravel.MinSwimDepth = 2

#    AutoTravel.MaxUnderwaterMs
#        Notbremse: bleibt der Charakter so lange untergetaucht, wird die Reise
#        beendet, bevor die Luft ausgeht.
#        Default: 45000
AutoTravel.MaxUnderwaterMs = 45000

#    AutoTravel.RescueUnderMesh
#        Erkennt, wenn der Charakter unter die begehbare Flaeche geraten ist,
#        und setzt ihn zurueck darauf. Das ist eine Stoerungsbehebung, kein
#        Reisemittel.
#        Default: 1
AutoTravel.RescueUnderMesh = 1

#    AutoTravel.UnderMeshDepth
#        Ab so vielen Yards unter der Reisehoehe gilt der Charakter als
#        durchgefallen.
#        Default: 2.5
AutoTravel.UnderMeshDepth = 2.5

#    AutoTravel.AboveMeshHeight
#        Ab so vielen Yards ueber der Reisehoehe gilt er als haengend oder
#        fallend und wird nach unten auf die Flaeche gesetzt. Grosszuegiger als
#        UnderMeshDepth, damit Spruenge und Rampen nicht ausloesen.
#        Default: 6
AutoTravel.AboveMeshHeight = 6

#    AutoTravel.LegDistance
#        Radius, ab dem ein ZWISCHENstuetzpunkt der Carbonite-Route als
#        erreicht gilt. Grosszuegiger als der Zielradius, weil es dort nicht
#        auf Genauigkeit ankommt.
#        Default: 15
AutoTravel.LegDistance = 15

#    AutoTravel.AutoMount
#        Automatisch ein Bodenmount benutzen, wenn erlaubt.
#        Default: 1
AutoTravel.AutoMount = 1

#    AutoTravel.MountMinDistance
#        Erst ab dieser Restdistanz (Yards) wird gemountet.
#        Default: 150
AutoTravel.MountMinDistance = 150

#    AutoTravel.PauseInCombat
#        Bewegung im Kampf pausieren und Kontrolle an den Spieler zurueckgeben.
#        Default: 1
AutoTravel.PauseInCombat = 1

#    AutoTravel.ResumeAfterCombat
#        Nach Kampfende automatisch neu pathen und weiterlaufen.
#        Default: 1
AutoTravel.ResumeAfterCombat = 1

#    AutoTravel.CombatGraceMs
#        Wartezeit nach Kampfende, bevor neu gepatht wird.
#        Default: 1500
AutoTravel.CombatGraceMs = 1500

#    AutoTravel.StuckDetection
#        Default: 1
AutoTravel.StuckDetection = 1

#    AutoTravel.StuckTimeoutMs
#        Messfenster fuer die Stuck-Erkennung.
#        Default: 5000
AutoTravel.StuckTimeoutMs = 5000

#    AutoTravel.StuckMinDistance
#        Minimale Strecke (Yards) innerhalb des Messfensters. Darunter gilt
#        der Charakter als haengengeblieben.
#        Default: 3
AutoTravel.StuckMinDistance = 3

#    AutoTravel.MaxRepathAttempts
#        Nach so vielen erfolglosen Versuchen wird abgebrochen (keine
#        Endlosschleife).
#        Default: 8
AutoTravel.MaxRepathAttempts = 8

#    AutoTravel.ResumeAfterDeath
#        Ziel nach dem Tod gespeichert lassen und nach Wiederbelebung
#        fortsetzen.
#        Default: 0
AutoTravel.ResumeAfterDeath = 0

#    AutoTravel.TakeClientControl
#        1 = Server uebernimmt waehrend der Fahrt die Bewegungskontrolle
#            (SetClientControl). Zuverlaessig, aber der Spieler kann waehrend
#            der Fahrt nicht selbst steuern.
#        0 = nur Splines ohne Kontrollentzug. Sanfter, aber der Client kann
#            gegensteuern und die Bewegung abbrechen.
#        Default: 1
AutoTravel.TakeClientControl = 1

#    AutoTravel.ChunkPoints
#        Wie viele Pfadpunkte pro Spline gesendet werden. Kleiner = feiner
#        reagierend, groesser = weniger Pakete.
#        Default: 12
AutoTravel.ChunkPoints = 12

########################################
# Natuerliche Navigation
########################################

# 1 = mehrere gueltige Wege bewerten.
# 0 = normale PathGenerator-Auswahl.
AutoTravel.NaturalPathing = 1

# Ab dieser Steigung beginnt eine zusaetzliche Strafe.
AutoTravel.SlopeStart = 0.15

# Deutlich steilere Steigung.
AutoTravel.SlopeStrong = 0.25

# Sehr steile Steigung.
AutoTravel.SlopeExtreme = 0.35

AutoTravel.SlopePenalty = 5.0
AutoTravel.SteepSlopePenalty = 10.0
AutoTravel.ExtremeSlopePenalty = 30.0

# Hoehengewinn wird ueber dieses Fenster bewertet.
AutoTravel.ElevationWindow = 40.0

AutoTravel.ElevationGainStart = 8.0
AutoTravel.ElevationGainStrong = 15.0
AutoTravel.ElevationGainExtreme = 25.0

AutoTravel.ElevationPenalty = 5.0
AutoTravel.StrongElevationPenalty = 20.0
AutoTravel.ExtremeElevationPenalty = 60.0

# Unnatuerliche starke Richtungswechsel.
AutoTravel.TurnPenaltyStart = 35.0
AutoTravel.TurnPenaltyStrong = 70.0
AutoTravel.TurnPenaltyExtreme = 110.0

AutoTravel.TurnPenalty = 2.0
AutoTravel.StrongTurnPenalty = 5.0
AutoTravel.ExtremeTurnPenalty = 12.0

# Unvollstaendige Wege werden nur als Notloesung akzeptiert.
AutoTravel.IncompletePathPenalty = 10000.0


########################################
# Contour / Bergumfahrung
########################################

# Wenn 1, sucht AutoTravel bei einem erkannten Berganstieg
# aktiv nach einem Weg links und rechts um den Berg.
AutoTravel.ContourProbing = 1

# Ab diesem nachhaltigen Hoehengewinn wird ein Pfad als
# moeglicher Berganstieg betrachtet.
AutoTravel.ContourTriggerElevation = 15.0

# Durchschnittliche Steigung, ab der Contour-Probing aktiviert wird.
AutoTravel.ContourTriggerSlope = 0.20

# Abstand der ersten beiden Suchrouten links/rechts.
#
# Narrow:
#   ca. 100 Yards neben der direkten Route
#
# Wide:
#   ca. 180 Yards neben der direkten Route
AutoTravel.ContourNarrowOffset = 100.0
AutoTravel.ContourWideOffset = 180.0

# Position der beiden Konturpunkte entlang A -> B.
#
# Beispiel:
#
# A ------------------------------ B
#       ^              ^
#      35%            65%
AutoTravel.ContourFirstProgress = 0.35
AutoTravel.ContourSecondProgress = 0.65

# Ein Contour-Pfad darf maximal so viel laenger sein als
# die direkte Luftstrecke, bevor er verworfen wird.
#
# 2.5 = maximal 250% der direkten Distanz.
AutoTravel.ContourMaxDistanceFactor = 2.5

########################################
# Reiseknoten von mod-playerbots
########################################
#
# mod-playerbots pflegt einen Graphen aus Reiseknoten (Tabellen
# playerbots_travelnode / _link). Dieser Graph kennt Verbindungen, die das
# NavMesh nicht kennen kann: Flugrouten, Portale, Schiffe. AutoTravel liest ihn
# per SQL - es besteht KEINE Kompilierabhaengigkeit zu mod-playerbots.
# Fehlen die Tabellen, benutzt AutoTravel weiterhin die Carbonite-Route.

#    AutoTravel.UseTravelNodes
#        Default: 1
AutoTravel.UseTravelNodes = 1

#    AutoTravel.NodeDatabase
#        Schemaname der Playerbot-Datenbank. Der MySQL-Benutzer des
#        worldservers braucht darauf Leserechte.
#        Default: "acore_playerbots"
AutoTravel.NodeDatabase = "acore_playerbots"

#    AutoTravel.NodeSearchRadius
#        Wie weit nach dem naechstgelegenen Knoten gesucht wird (Yards).
#        Default: 800
AutoTravel.NodeSearchRadius = 800

#    AutoTravel.NodeMinDistance
#        Erst ab dieser Zielentfernung wird der Knotengraph benutzt. Darunter
#        pathet das NavMesh direkt, das ist genauer.
#        Default: 300
AutoTravel.NodeMinDistance = 300

#    AutoTravel.UseSpecialLinks
#        Verbindungen, die nicht gelaufen werden (Flug, Portal, Schiff) in die
#        Routensuche einbeziehen. Der Spieler muss sie selbst ausloesen.
#        Default: 1
AutoTravel.UseSpecialLinks = 1

#    AutoTravel.SpecialLinkCost
#        Aufschlag in Yards fuer eine Sonderverbindung, damit sie nur benutzt
#        wird, wenn sie wirklich viel Strecke spart.
#        Default: 400
AutoTravel.SpecialLinkCost = 400

#    AutoTravel.AllowTeleport
#        Erlaubt den Teleport-Knopf des Addons (.at tp). Steht das auf 0,
#        funktioniert nur das Laufen.
#        Default: 1
AutoTravel.AllowTeleport = 1

#    AutoTravel.TeleportMinDistance
#        Unter dieser Entfernung wird der Teleport abgelehnt (0 = keine Grenze).
#        Sinnvoll, damit kurze Strecken gelaufen statt gesprungen werden.
#        Default: 0
AutoTravel.TeleportMinDistance = 0

#    AutoTravel.TeleportCooldownSec
#        Abklingzeit zwischen zwei Teleports.
#        Default: 5
AutoTravel.TeleportCooldownSec = 5

#    AutoTravel.Debug
#        Serverweiter Debug-Modus.
#        Default: 0
AutoTravel.Debug = 0
