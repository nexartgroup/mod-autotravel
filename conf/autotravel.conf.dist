#
# mod-autotravel  --  Konfiguration
# ---------------------------------------------------------------------------
# ERZEUGTE DATEI. Nicht von Hand aendern -- sie entsteht aus der Optionsregistry
# in src/AutoTravel_Config.cpp (Werkzeug: autotravel-tools/gen/gen_conf.py).
#
# Diese Datei nach autotravel.conf kopieren und DORT aendern. Die .dist wird
# bei einem Update ueberschrieben, die .conf nicht.
#
# Jeder Wert laesst sich zusaetzlich im laufenden Betrieb setzen:
#
#     .at options            zeigt alle Werte mit ihrem aktuellen Stand
#     .at options fly        zeigt nur Werte, die zum Fliegen gehoeren
#     .at set fly 0          schaltet das Fliegen ab
#
# Aenderungen im laufenden Betrieb gelten bis zum naechsten Serverneustart und
# brauchen Spielleiterrechte. Ausgenommen sind 'arrival' und 'grace': die
# gelten nur fuer die eigene Reise und darf jeder Spieler setzen.
#
# VORAUSSETZUNGEN
#   * mmaps muessen erzeugt und in worldserver.conf aktiviert sein
#     (MoveMaps.Enable = 1). Ohne sie kann der Server keinen Weg berechnen.
#   * vmaps werden fuer die Hoehen gebraucht (Vmap.EnableHeight = 1).
#   * dbc/WorldMapArea.dbc muss unter DataDir liegen. AzerothCore legt dafuer
#     keinen eigenen Speicher an, deshalb liest dieses Modul die Datei selbst.
#   * mod-playerbots ist optional. Ist es vorhanden, benutzt AutoTravel seinen
#     Reiseknotengraphen; fehlt es, faellt es auf die Carbonite-Route zurueck.
#
# ---------------------------------------------------------------------------

[worldserver]


#--------------------------------------------------------------------------
#   Grundbetrieb
#--------------------------------------------------------------------------

#    Modul aktiv
#    0 = aus, 1 = an
#    Laufzeitschluessel: enable
AutoTravel.Enable = 1

#    ausfuehrliche Serverausgabe
#    0 = aus, 1 = an
#    Laufzeitschluessel: debug
AutoTravel.Debug = 0

#    Zielradius der letzten Etappe (yd)
#    erlaubt: 0.5 bis 100
#    Laufzeitschluessel: arrival
AutoTravel.ArrivalDistance = 8

#    Radius der Zwischenetappen (yd)
#    erlaubt: 1 bis 120
#    Laufzeitschluessel: leg
AutoTravel.LegDistance = 15

#    NavMesh-Punkte je Spline-Abschnitt
#    erlaubt: 2 bis 60
#    Laufzeitschluessel: chunk
AutoTravel.ChunkPoints = 12

#    Abtastweite entlang eines Abschnitts (yd)
#    erlaubt: 0.5 bis 10
#    Laufzeitschluessel: step
AutoTravel.TerrainStep = 3

#    Taktweite des Moduls (ms)
#    erlaubt: 50 bis 1000
#    Laufzeitschluessel: tick
AutoTravel.UpdateIntervalMs = 200

#--------------------------------------------------------------------------
#   Uebergabe zwischen Spieler und Autopilot
#--------------------------------------------------------------------------

#    Clientkontrolle waehrend der Fahrt uebernehmen
#    0 = aus, 1 = an
#    Laufzeitschluessel: control
AutoTravel.TakeClientControl = 1

#    im Kampf pausieren und Kontrolle abgeben
#    0 = aus, 1 = an
#    Laufzeitschluessel: combatpause
AutoTravel.PauseInCombat = 1

#    nach dem Kampf weiterfahren
#    0 = aus, 1 = an
#    Laufzeitschluessel: combatresume
AutoTravel.ResumeAfterCombat = 1

#    Wartezeit nach dem Kampf (ms)
#    erlaubt: 0 bis 30000
#    Laufzeitschluessel: grace
AutoTravel.CombatGraceMs = 2000

#    Ziel nach dem Tod behalten
#    0 = aus, 1 = an
#    Laufzeitschluessel: deathresume
AutoTravel.ResumeAfterDeath = 0

#    Abbruch, wenn der Spieler dauerhaft uebernimmt (ms)
#    erlaubt: 10000 bis 3600000
#    Laufzeitschluessel: handover
AutoTravel.HandoverTimeoutMs = 900000

#    AFK-Kennzeichen loeschen, solange der Autopilot faehrt
#    0 = aus, 1 = an
#    Laufzeitschluessel: afk
AutoTravel.SuppressAfk = 1

#--------------------------------------------------------------------------
#   Feststecken
#--------------------------------------------------------------------------

#    Feststecken erkennen
#    0 = aus, 1 = an
#    Laufzeitschluessel: stuck
AutoTravel.StuckDetection = 1

#    Messfenster fuer Feststecken (ms)
#    erlaubt: 1000 bis 60000
#    Laufzeitschluessel: stucktime
AutoTravel.StuckTimeoutMs = 5000

#    Mindestfortschritt im Messfenster (yd)
#    erlaubt: 0.5 bis 50
#    Laufzeitschluessel: stuckdist
AutoTravel.StuckMinDistance = 3

#    Versuche, bevor aufgegeben wird
#    erlaubt: 1 bis 50
#    Laufzeitschluessel: repath
AutoTravel.MaxRepathAttempts = 8

#--------------------------------------------------------------------------
#   Reittiere
#--------------------------------------------------------------------------

#    Reittier automatisch rufen
#    0 = aus, 1 = an
#    Laufzeitschluessel: mount
AutoTravel.AutoMount = 1

#    ab dieser Restentfernung aufsitzen (yd)
#    erlaubt: 0 bis 5000
#    Laufzeitschluessel: mountdist
AutoTravel.MountMinDistance = 150

#    in Gebaeuden absteigen
#    0 = aus, 1 = an
#    Laufzeitschluessel: dismount
AutoTravel.DismountIndoors = 1

#--------------------------------------------------------------------------
#   Fliegen mit eigenem Flugmount
#--------------------------------------------------------------------------

#    eigenes Flugmount benutzen, wo erlaubt
#    0 = aus, 1 = an
#    Laufzeitschluessel: fly
AutoTravel.AllowFlying = 1

#    ab dieser Entfernung fliegen (yd)
#    erlaubt: 100 bis 10000
#    Laufzeitschluessel: flydist
AutoTravel.FlyMinDistance = 400

#    Sicherheitsabstand ueber Gelaende (yd)
#    erlaubt: 5 bis 200
#    Laufzeitschluessel: flyclear
AutoTravel.FlyClearance = 25

#    Abtastweite des Hoehenprofils (yd)
#    erlaubt: 5 bis 100
#    Laufzeitschluessel: flysample
AutoTravel.FlySampleStep = 25

#    hoechste Flughoehe ueber Grund (yd)
#    erlaubt: 30 bis 1000
#    Laufzeitschluessel: flymax
AutoTravel.FlyMaxHeight = 250

#    Beginn des Sinkflugs vor dem Ziel (yd)
#    erlaubt: 10 bis 400
#    Laufzeitschluessel: flyland
AutoTravel.FlyDescendDistance = 60

#--------------------------------------------------------------------------
#   Flugmeister
#--------------------------------------------------------------------------

#    Flugmeister selbstaendig benutzen
#    0 = aus, 1 = an
#    Laufzeitschluessel: taxi
AutoTravel.UseTaxi = 1

#    ab dieser Restentfernung Flug pruefen (yd)
#    erlaubt: 200 bis 50000
#    Laufzeitschluessel: taxidist
AutoTravel.TaxiMinDistance = 1500

#    Anteil der Strecke, den der Flug sparen muss
#    erlaubt: 0 bis 0.95
#    Laufzeitschluessel: taxisaving
AutoTravel.TaxiMinSaving = 0.6

#    hoechster Fussweg zum Flugmeister (yd)
#    erlaubt: 50 bis 10000
#    Laufzeitschluessel: taxiwalk
AutoTravel.TaxiMaxWalkToNode = 1200

#    Preisgrenze je Flug in Kupfer
#    erlaubt: 0 bis 100000000
#    Laufzeitschluessel: taxicost
AutoTravel.TaxiMaxCostCopper = 50000

#    Naehe zum Flugmeister zum Abheben (yd)
#    erlaubt: 2 bis 9.5
#    Laufzeitschluessel: taxiboard
AutoTravel.TaxiBoardDistance = 8

#--------------------------------------------------------------------------
#   Transporte: Zeppelin, Schiff, Tiefenbahn
#--------------------------------------------------------------------------

#    Zeppelin, Schiff und Bahn begleiten
#    0 = aus, 1 = an
#    Laufzeitschluessel: transport
AutoTravel.UseTransports = 1

#    Wartezeit am Anleger (ms)
#    erlaubt: 30000 bis 1800000
#    Laufzeitschluessel: transportwait
AutoTravel.TransportWaitMs = 300000

#--------------------------------------------------------------------------
#   Schwimmen
#--------------------------------------------------------------------------

#    schwimmen erlaubt
#    0 = aus, 1 = an
#    Laufzeitschluessel: swim
AutoTravel.Swim = 1

#    Tiefe unter der Wasseroberflaeche (yd)
#    erlaubt: 0 bis 5
#    Laufzeitschluessel: swimoffset
AutoTravel.SwimSurfaceOffset = 1.2

#    ab dieser Wassertiefe wird geschwommen (yd)
#    erlaubt: 0.5 bis 20
#    Laufzeitschluessel: swimdepth
AutoTravel.MinSwimDepth = 2

#    Abbruch nach dieser Zeit unter Wasser (ms)
#    erlaubt: 5000 bis 300000
#    Laufzeitschluessel: swimair
AutoTravel.MaxUnderwaterMs = 45000

#    Zusatzkosten je Yard Schwimmstrecke
#    erlaubt: 0 bis 20
#    Laufzeitschluessel: waterpenalty
AutoTravel.WaterPenalty = 1.5

#--------------------------------------------------------------------------
#   Bodenkontakt und Etagen
#--------------------------------------------------------------------------

#    bei fehlendem Bodenkontakt zuruecksetzen
#    0 = aus, 1 = an
#    Laufzeitschluessel: rescue
AutoTravel.RescueUnderMesh = 1

#    Tiefe, ab der es als durchgefallen gilt (yd)
#    erlaubt: 0.5 bis 20
#    Laufzeitschluessel: under
AutoTravel.UnderMeshDepth = 2.5

#    Hoehe, ab der es als schwebend gilt (yd)
#    erlaubt: 2 bis 60
#    Laufzeitschluessel: above
AutoTravel.AboveMeshHeight = 12

#    Suchfenster um die Pfadhoehe (yd)
#    erlaubt: 4 bis 60
#    Laufzeitschluessel: rescuerange
AutoTravel.RescueSearchRange = 14

#    Rettungen, bevor abgebrochen wird
#    erlaubt: 1 bis 50
#    Laufzeitschluessel: maxrescue
AutoTravel.MaxRescues = 6

#    groesste Neigung, die als Laufflaeche gilt
#    erlaubt: 0.3 bis 3
#    Laufzeitschluessel: walkslope
AutoTravel.MaxWalkSlope = 1.2

#    Abweichung, ab der ein Punkt Ausreisser ist (yd)
#    erlaubt: 0.5 bis 20
#    Laufzeitschluessel: zoutlier
AutoTravel.ZOutlierTolerance = 2.5

#    groesste Stufe nach oben (yd)
#    erlaubt: 0.5 bis 10
#    Laufzeitschluessel: stepup
AutoTravel.MaxStepUp = 2.5

#    groesster Absatz nach unten (yd)
#    erlaubt: 1 bis 40
#    Laufzeitschluessel: stepdown
AutoTravel.MaxStepDown = 6

#    wie viele Etagen je Punkt gesucht werden
#    erlaubt: 1 bis 8
#    Laufzeitschluessel: planes
AutoTravel.GroundPlanes = 4

#--------------------------------------------------------------------------
#   Reiseknoten aus mod-playerbots
#--------------------------------------------------------------------------

#    Knotengraph von mod-playerbots benutzen
#    0 = aus, 1 = an
#    Laufzeitschluessel: nodes
AutoTravel.UseTravelNodes = 1

#    Suchradius fuer den naechsten Knoten (yd)
#    erlaubt: 50 bis 10000
#    Laufzeitschluessel: noderadius
AutoTravel.NodeSearchRadius = 800

#    ab dieser Entfernung Knoten benutzen (yd)
#    erlaubt: 0 bis 10000
#    Laufzeitschluessel: nodemin
AutoTravel.NodeMinDistance = 300

#    Umwegfaktor, ab dem der Startknoten entfaellt
#    erlaubt: 1 bis 5
#    Laufzeitschluessel: nodeskip
AutoTravel.SkipDetourFactor = 1.25

#    Portale und Transporte im Graphen erlauben
#    0 = aus, 1 = an
#    Laufzeitschluessel: speciallinks
AutoTravel.UseSpecialLinks = 1

#    Aufschlag fuer Sonderverbindungen
#    erlaubt: 0 bis 100000
#    Laufzeitschluessel: specialcost
AutoTravel.SpecialLinkCost = 400

#--------------------------------------------------------------------------
#   Teleport
#--------------------------------------------------------------------------

#    Teleportbefehl erlaubt
#    0 = aus, 1 = an
#    Laufzeitschluessel: teleport
AutoTravel.AllowTeleport = 1

#    Rechtestufe fuer den Teleport
#    erlaubt: 0 bis 3
#    Laufzeitschluessel: teleportsec
AutoTravel.TeleportSecurity = 2

#    Mindestentfernung fuer den Teleport (yd)
#    erlaubt: 0 bis 50000
#    Laufzeitschluessel: teleportmin
AutoTravel.TeleportMinDistance = 0

#    Abklingzeit des Teleports (s)
#    erlaubt: 0 bis 3600
#    Laufzeitschluessel: teleportcd
AutoTravel.TeleportCooldownSec = 5

#--------------------------------------------------------------------------
#   Bewertung natuerlicher Wege
#--------------------------------------------------------------------------

#    natuerliche Wege bevorzugen
#    0 = aus, 1 = an
#    Laufzeitschluessel: natural
AutoTravel.NaturalPathing = 1

#    Neigung, ab der Strafe faellt
#    erlaubt: 0 bis 3
#    Laufzeitschluessel: slopestart
AutoTravel.SlopeStart = 0.15

#    Neigung fuer die zweite Stufe
#    erlaubt: 0 bis 3
#    Laufzeitschluessel: slopestrong
AutoTravel.SlopeStrong = 0.25

#    Neigung fuer die dritte Stufe
#    erlaubt: 0 bis 3
#    Laufzeitschluessel: slopeextreme
AutoTravel.SlopeExtreme = 0.35

#    Strafe erste Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: slopecost
AutoTravel.SlopePenalty = 5

#    Strafe zweite Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: slopecost2
AutoTravel.SteepSlopePenalty = 10

#    Strafe dritte Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: slopecost3
AutoTravel.ExtremeSlopePenalty = 30

#    Fensterlaenge fuer den Hoehengewinn (yd)
#    erlaubt: 10 bis 400
#    Laufzeitschluessel: elevwindow
AutoTravel.ElevationWindow = 40

#    Hoehengewinn erste Stufe (yd)
#    erlaubt: 0 bis 200
#    Laufzeitschluessel: elevstart
AutoTravel.ElevationGainStart = 4

#    Hoehengewinn zweite Stufe (yd)
#    erlaubt: 0 bis 200
#    Laufzeitschluessel: elevstrong
AutoTravel.ElevationGainStrong = 10

#    Hoehengewinn dritte Stufe (yd)
#    erlaubt: 0 bis 200
#    Laufzeitschluessel: elevextreme
AutoTravel.ElevationGainExtreme = 20

#    Strafe erste Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: elevcost
AutoTravel.ElevationPenalty = 3

#    Strafe zweite Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: elevcost2
AutoTravel.StrongElevationPenalty = 8

#    Strafe dritte Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: elevcost3
AutoTravel.ExtremeElevationPenalty = 20

#    Winkel, ab dem Strafe faellt (Grad)
#    erlaubt: 0 bis 180
#    Laufzeitschluessel: turnstart
AutoTravel.TurnPenaltyStart = 35

#    Winkel zweite Stufe (Grad)
#    erlaubt: 0 bis 180
#    Laufzeitschluessel: turnstrong
AutoTravel.TurnPenaltyStrong = 70

#    Winkel dritte Stufe (Grad)
#    erlaubt: 0 bis 180
#    Laufzeitschluessel: turnextreme
AutoTravel.TurnPenaltyExtreme = 110

#    Strafe erste Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: turncost
AutoTravel.TurnPenalty = 2

#    Strafe zweite Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: turncost2
AutoTravel.StrongTurnPenalty = 5

#    Strafe dritte Stufe
#    erlaubt: 0 bis 1000
#    Laufzeitschluessel: turncost3
AutoTravel.ExtremeTurnPenalty = 12

#    Aufschlag fuer Teilwege
#    erlaubt: 0 bis 1e+06
#    Laufzeitschluessel: incomplete
AutoTravel.IncompletePathPenalty = 10000

#    Aufschlag je erkanntem Absturz
#    erlaubt: 0 bis 100000
#    Laufzeitschluessel: cliffcost
AutoTravel.CliffPenalty = 400

#--------------------------------------------------------------------------
#   Suche um Hindernisse herum
#--------------------------------------------------------------------------

#    Weg um den Berg herum suchen
#    0 = aus, 1 = an
#    Laufzeitschluessel: contour
AutoTravel.ContourProbing = 1

#    Hoehengewinn, der die Suche ausloest (yd)
#    erlaubt: 1 bis 200
#    Laufzeitschluessel: contour_elevation
AutoTravel.ContourTriggerElevation = 15

#    Steigung, die die Suche ausloest
#    erlaubt: 0.01 bis 3
#    Laufzeitschluessel: contour_slope
AutoTravel.ContourTriggerSlope = 0.2

#    erster Suchabstand seitlich (yd)
#    erlaubt: 10 bis 1000
#    Laufzeitschluessel: contour_narrow
AutoTravel.ContourNarrowOffset = 100

#    zweiter Suchabstand seitlich (yd)
#    erlaubt: 10 bis 2000
#    Laufzeitschluessel: contour_wide
AutoTravel.ContourWideOffset = 180

#    Lage des ersten Suchpunkts auf der Strecke
#    erlaubt: 0.05 bis 0.9
#    Laufzeitschluessel: contour_first
AutoTravel.ContourFirstProgress = 0.35

#    Lage des zweiten Suchpunkts
#    erlaubt: 0.1 bis 0.95
#    Laufzeitschluessel: contour_second
AutoTravel.ContourSecondProgress = 0.65

#    hoechster Umwegfaktor der Contour-Route
#    erlaubt: 1 bis 10
#    Laufzeitschluessel: contour_factor
AutoTravel.ContourMaxDistanceFactor = 2.5

#--------------------------------------------------------------------------
#   Reiseknoten: Datenbankname
#--------------------------------------------------------------------------

#    Datenbank, in der mod-playerbots die Tabellen playerbots_travelnode
#    und playerbots_travelnode_link haelt. Der Weltserver braucht dort
#    Leserecht.
AutoTravel.NodeDatabase = "acore_playerbots"
